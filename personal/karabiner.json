{
  "_comment": "Personal layer Karabiner rules. Merged by karabiner/build.sh; keys starting with _ are stripped.",
  "rules": [
    {
      "description": "Tabby: physical Alt (= Cmd in Logitech Mac mode) + . b f d Backspace act as Meta (Esc-prefixed) for bash/readline",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^org\\.tabby$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "period",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "key_code": "period"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^org\\.tabby$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "key_code": "b"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^org\\.tabby$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "f",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "key_code": "f"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^org\\.tabby$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "key_code": "d"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^org\\.tabby$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "delete_or_backspace",
            "modifiers": {
              "mandatory": [
                "command"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            },
            {
              "key_code": "delete_or_backspace"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ],
  "simple_modifications": [
    {
      "_comment": "Caps Lock as Escape: habit, not GNOME. Escape becomes Caps Lock so it is still reachable.",
      "from": {
        "key_code": "caps_lock"
      },
      "to": [
        {
          "key_code": "escape"
        }
      ]
    },
    {
      "from": {
        "key_code": "escape"
      },
      "to": [
        {
          "key_code": "caps_lock"
        }
      ]
    }
  ]
}
