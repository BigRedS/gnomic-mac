#!/bin/sh

if [ -z $1 ]; then
  print "Provide a duti.conf file as an argument"
  print "It's probably in this directory"
  exit 1
fi

conf=$1

# ~/bin/fix-defaults: re-apply ~/.duti, but only where it's drifted
grep -v '^\s*#' $conf | while read -r app uti role; do
  [ -z "$app" ] && continue
  current=$(duti -d "$uti" 2>/dev/null)
  [ "$current" = "$app" ] || duti -s "$app" "$uti" "$role"
done
